{
  "name": "@ryumy97/floaty-react",
  "version": "0.1.0",
  "description": "Render persistent React content on top of the screen that follows layout anchors across layout changes.",
  "license": "MIT",
  "author": "ryumy97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryumy97/floaty.git",
    "directory": "packages/react"
  },
  "homepage": "https://floaty.ryumy.com/",
  "bugs": {
    "url": "https://github.com/ryumy97/floaty/issues"
  },
  "keywords": [
    "react",
    "floaty",
    "portal",
    "layout",
    "animation",
    "shared-element"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
